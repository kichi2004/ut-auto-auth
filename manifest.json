{
  "name": "__MSG_extensionName__",
  "short_name": "ut-auto-auth",
  "version": "1.1.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ja",
  "content_scripts": [
    {
      "matches": [
        "https://idp.account.tsukuba.ac.jp/idp/profile/SAML2/Redirect/SSO*",
